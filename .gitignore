# Live exchange mode: recorded quotes (research data, publish separately) and instrument-master cache
research/recordings/
data/cache/
# Research artifacts: data stays out; research/.gitignore re-includes small results (*.json),
# run logs and manifests, so the replication package carries every reported number.
research/artifacts/*

# Semantic microservice (services/semantic): secrets, caches, runtime data.
# Only config.toml.example is committed; the real config.toml holds API keys.
services/semantic/config.toml
**/gcp-credentials*.json
services/semantic/artifacts/*
!services/semantic/artifacts/usdinr_targeted_expanded/
services/semantic/artifacts/usdinr_targeted_expanded/*
!services/semantic/artifacts/usdinr_targeted_expanded/reaction_model_artifact.json
# Release reaction model (SEMANTIC_REACTION_V2), exported by research/run_reaction_eval.py
!services/semantic/artifacts/release_reaction/
services/semantic/artifacts/release_reaction/*
!services/semantic/artifacts/release_reaction/reaction_model.json
!services/semantic/artifacts/pooled_multipair/
services/semantic/artifacts/pooled_multipair/*
!services/semantic/artifacts/pooled_multipair/reaction_model_artifact.json
!services/semantic/artifacts/pooled_multipair/training_report.json
# Derived (~29 MB): regenerate with scripts/export_calendar_reaction_rows.py; the summary is kept.
services/semantic/data/calendar_reaction_rows.jsonl
services/semantic/frontend/node_modules/
services/semantic/frontend/test-results/
.pytest_cache/
.mypy_cache/
*.bak
*.zip
