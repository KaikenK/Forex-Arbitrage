[finnhub]
api_key = ""
poll_interval_seconds = 30
company_news_symbols = ["EUR", "GBP", "JPY"]

[alpha_vantage]
api_key = ""

[rss]
poll_interval_seconds = 60

[official_feeds]
poll_interval_seconds = 300
feed_urls = [
	"https://www.federalreserve.gov/feeds/press_monetary.xml",
	"https://www.federalreserve.gov/feeds/speeches.xml",
	"https://www.ecb.europa.eu/rss/press.html",
	"https://www.ecb.europa.eu/rss/speeches.html",
	"https://www.bankofengland.co.uk/rss/news"
]

[analyzer]
recency_window_seconds = 60
zscore_window = 1000

[watchlist]
symbols = ["EUR/USD","GBP/USD","USD/JPY","USD/CHF","AUD/USD"]

[runtime]
use_rag = true
use_sentence_transformer = true
use_finbert = true

[storage]
analysis_history_path = "artifacts/history/analysis_history.jsonl"
