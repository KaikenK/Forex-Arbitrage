# Copy to .env (git-ignored) and fill in. Never commit .env.

# Pick the pipeline: SYNTHETIC_USDINR_ONLY (default) | LIVE_USDINR_EXCHANGES | LIVE_MT5
ARBEX_DATA_MODE=LIVE_USDINR_EXCHANGES

# Upstox — free market data. Developer console -> create app -> Analytics Token
# (valid ~1 year, read-only market data). Keep the trading account unfunded.
UPSTOX_ACCESS_TOKEN=

# Kite Connect — low-cost showcase provider (₹500/month data plan).
# The access token expires daily (~06:00 IST); regenerate it each session.
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Optional
# ARBEX_LIVE_PROVIDERS=upstox,kite
# ARBEX_LIVE_EXCHANGES=NSE,BSE
# ARBEX_RECORD_DIR=research/recordings      # "off" to disable recording
# ARBEX_LIVE_REPLAY=research/recordings/2026-10-12
# ARBEX_REPLAY_SPEED=1.0
# ARBEX_REPLAY_LOOP=1
# UPSTOX_POLL_INTERVAL=1.0
# KITE_POLL_INTERVAL=1.0
