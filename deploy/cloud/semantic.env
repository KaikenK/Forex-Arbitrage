# Semantic service (:9000) on the cloud server: same switches as the laptop's semantic.cmd.
SEMANTIC_CURRENCY_BIAS=1
SEMANTIC_REACTION_V2=1
SEMANTIC_FX_RELEVANCE_FILTER=1
NEWS_STREAM_USE_FINBERT=1
HF_HOME=/var/lib/arbex/hf
HF_HUB_OFFLINE=1
ARBEX_CACHE_DIR=/var/lib/arbex/cache
SEMANTIC_HOST=127.0.0.1
SEMANTIC_PORT=9000
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
