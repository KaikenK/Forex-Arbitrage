[Unit]
Description=Arbex semantic service (news reader, FinBERT) on :9000
After=network-online.target
Wants=network-online.target

[Service]
User=arbex
Group=arbex
EnvironmentFile=/etc/arbex/semantic.env
ExecStart=/opt/arbex/start-semantic.sh
Restart=always
RestartSec=10
TimeoutStartSec=300
# uvicorn waits for the backend's open /v1/feed stream on stop; do not wait 90 s for it
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
