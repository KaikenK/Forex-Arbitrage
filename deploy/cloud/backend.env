# Backend + live recorder (:8000) on the cloud server: same switches as the laptop's backend.cmd
# (live mode, Phase 2 on, C43 shadow on), with every output under /var/lib/arbex.
ARBEX_DATA_MODE=LIVE_USDINR_EXCHANGES
ARBEX_SYMBOLS=USDINR,EURUSD,GBPUSD,USDJPY,USDCHF
ARBEX_RECORD_DIR=/var/lib/arbex/recordings
ARBEX_SEMANTIC_SHADOW=1
ARBEX_SHADOW_DIR=/var/lib/arbex/shadow
SEMANTIC_RUNTIME_DIR=/var/lib/arbex/runtime
ARBEX_CACHE_DIR=/var/lib/arbex/cache
ARBEX_APPLY_SEMANTIC=risk
SEMANTIC_DIRECTION_SOURCE=currency_index
SEMANTIC_FX_RELEVANCE_FILTER=1
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
